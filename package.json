    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.2.0",
    "jsdom": "^31.0.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
